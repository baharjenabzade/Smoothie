# Copy to .env and adjust. Never commit the real .env file.
ENVIRONMENT=development

# PostgreSQL (SQLAlchemy URL, psycopg v3 driver)
DATABASE_URL=postgresql+psycopg://ielts:ielts@localhost:5432/ielts

# JWT. Generate a real secret with:  openssl rand -hex 32
SECRET_KEY=change-me-generate-with-openssl-rand-hex-32
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# JSON list of allowed browser origins for the future web frontend
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# Which AI does the evaluating: "ollama" (local model) or "gemini" (Google Gemini API)
LLM_PROVIDER=ollama

# --- Gemini (only used when LLM_PROVIDER=gemini) ---
# Create a key at https://aistudio.google.com/apikey  (keep it private, never commit it)
GEMINI_API_KEY=
# Model names change over time. Run `python -m app.gemini_models` to list the ones your key can use.
GEMINI_MODEL=gemini-2.5-flash

# --- Ollama (only used when LLM_PROVIDER=ollama) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_TIMEOUT_SECONDS=180
OLLAMA_TEMPERATURE=0.3
OLLAMA_NUM_CTX=8192
# Qwen3 "thinking" mode. Off = faster and cleaner JSON output.
OLLAMA_THINK=false

# "strict" caps scores by answer length and verified grammar errors and rounds the overall band down.
# "standard" trusts the model's scores. 
SCORING_STRICTNESS=strict

# RAG: graded reference answers in knowledge/samples/*.json (see knowledge/README.md)
RAG_ENABLED=true
RAG_TOP_K=3
